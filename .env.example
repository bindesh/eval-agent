# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Anything already exported in your shell takes precedence over these values.

# Only needed when judge.provider is "anthropic" (console.anthropic.com -> API keys).
# This is a pay-as-you-go Console account, separate from a Claude Code subscription.
# Not needed at all with judge.provider "claude-code", "heuristic" or "mock".
ANTHROPIC_API_KEY=

# Optional: the agent executable, if `claude` is not on your PATH.
# CLAUDE_EXECUTABLE=~/.local/bin/claude
